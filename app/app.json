{
  "expo": {
    "name": "Matobev",
    "slug": "matobev",
    "scheme": "matobev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matobev.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.matobev.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0A1628"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Matobev to access your photos to upload highlights and your profile picture.",
          "cameraPermission": "Allow Matobev to use your camera to record highlights."
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-image"
    ]
  }
}
