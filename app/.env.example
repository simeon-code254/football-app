EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry error monitoring. Paste the DSN from the React Native project at
# sentry.io (Settings -> Client Keys). Safe to expose -- a DSN only permits
# writing events, never reading them. Leave blank to disable reporting.
EXPO_PUBLIC_SENTRY_DSN=
