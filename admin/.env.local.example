# Copy to .env.local and fill in real values. .env.local is gitignored.
#
# Same Supabase project as app/.env and ai-service/.env (ref qefovzbhnmdhbqldtptc).
# NEXT_PUBLIC_SUPABASE_ANON_KEY is not secret -- it's the exact same public
# anon key already in app/.env's EXPO_PUBLIC_SUPABASE_ANON_KEY.
#
# Do NOT add SUPABASE_SERVICE_ROLE_KEY here or anywhere in this project. This
# app is a browser-bundled client that authenticates as a real logged-in
# admin user and relies entirely on RLS (is_admin()-gated policies) -- same
# trust model as the mobile app. A service-role key has no legitimate use
# here and must never be shipped to a browser bundle.

NEXT_PUBLIC_SUPABASE_URL=https://qefovzbhnmdhbqldtptc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
