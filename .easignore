# Controls what EAS Build uploads. The archive is built from the repo root,
# so without this file EAS sweeps in ai-service/data (~8.8 GB) and .venv (~1.6 GB)
# and blows past the 2 GB upload limit.
#
# IMPORTANT: when this file exists, EAS ignores EVERY .gitignore in the repo.
# Anything that must stay out of the build has to be listed here, including the
# rules that app/.gitignore would otherwise cover.

# --- Nothing outside app/ is needed to build the mobile app ---
ai-service/
ai-service/**
admin/
admin/**
supabase/
supabase/**
docs/
docs/**
.github/
.github/**
.claude/
.claude/**

# --- app/.gitignore equivalents (no longer honored by EAS) ---
app/node_modules/
app/node_modules/**
app/.expo/
app/.expo/**
app/dist/
app/dist/**
app/web-build/
app/web-build/**
app/expo-env.d.ts
app/.metro-health-check*

# Native folders are generated by prebuild on EAS, never uploaded
app/ios/
app/ios/**
app/android/
app/android/**
app/.kotlin/

# Secrets and signing material — supply these via EAS env vars / credentials
app/.env
app/.env*.local
app/*.jks
app/*.p8
app/*.p12
app/*.key
app/*.pem
app/*.mobileprovision

# Local noise
app/*.tsbuildinfo
app/*.orig.*
app/npm-debug.*
app/yarn-debug.*
app/yarn-error.*
**/.DS_Store
**/__pycache__/
