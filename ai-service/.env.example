# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Not secret — same value as EXPO_PUBLIC_SUPABASE_URL in app/.env
SUPABASE_URL=https://qefovzbhnmdhbqldtptc.supabase.co

# Secret. Service role key from Supabase dashboard > Project Settings > API.
# Bypasses RLS entirely — this is what lets the service write
# video_analysis_jobs/player_attribute_scores, which no authenticated user
# can write directly. Never share, never commit, never log this value.
SUPABASE_SERVICE_ROLE_KEY=

# How often (seconds) the polling safety-net checks for missed queued jobs,
# in addition to the realtime subscription.
POLL_INTERVAL_SECONDS=120
